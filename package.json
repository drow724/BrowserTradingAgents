    "@langchain/langgraph": "1.4.18",
    "akarisp": "0.1.0-alpha.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
