{
  "name": "browser-trading-agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test test/*.test.ts",
    "test:browser": "playwright test --project=chromium",
