{
  "name": "browser-trading-agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test test/*.test.ts",
    "test:browser": "playwright test --project=chromium",
    "dev": "vite",
    "harness": "vite",
    "test:prompt-api": "playwright test --project=prompt-api",
    "prepare:prompt-api": "sh scripts/prepare-prompt-api-profile.sh",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "next:typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "akarisp": "0.1.0-alpha.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
