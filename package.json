{
  "name": "browser-trading-agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "prebuild": "node scripts/copy-pixel-agents.mjs",
    "build": "next build",
    "start": "next start",
    "test": "node --test test/*.test.ts",
    "test:browser": "playwright test --project=chromium",
    "test:browser:dev": "BTA_DEV_SMOKE=1 playwright test --project=chromium-dev",
    "predev": "node scripts/copy-pixel-agents.mjs",
    "dev": "next dev",
    "test:prompt-api": "playwright test --project=prompt-api",
    "prepare:prompt-api": "sh scripts/prepare-prompt-api-profile.sh"
  },
  "dependencies": {
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "akarisp": "0.1.0-alpha.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pixel-agents": "1.4.1",
    "typescript": "^5.9.3"
  }
}
